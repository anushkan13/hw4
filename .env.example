# Campus Customs — environment variables
# Copy this file to .env in this folder and fill in your own values.
# .env is gitignored; never commit real keys.

# Required. Portkey API key used to reach the OpenAI model.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. The chat model. Defaults to gpt-5.6-luna when unset.
# Step-up options: gpt-5.6-terra, gpt-5.6-sol, gpt-6-astra
MODEL_NAME=gpt-5.6-luna

# Optional. Secret used to sign login session tokens. When unset, the backend
# generates one into backend/.session_secret (gitignored) on first run.
CAMPUS_CUSTOMS_SECRET=change-me-to-a-long-random-string

# Optional, frontend only. Point the UI at a deployed backend instead of the
# Vite dev proxy. Leave unset for local development.
# VITE_API_BASE_URL=https://your-backend.example.com
